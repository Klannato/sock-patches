  "entrypoints": {
    "main": [
      "dev.geo.sockschunkfix.SocksChunkFix"
    ]
  },
  "mixins": [
    "socks-chunkfix.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.20.1"
  }
}
